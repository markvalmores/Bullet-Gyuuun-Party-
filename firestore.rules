rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; 
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'username', 'goldenCarrots', 'inventory', 'createdAt']) &&
               data.uid == request.auth.uid &&
               data.username is string && data.username.size() <= 50 &&
               data.goldenCarrots is number &&
               data.inventory is map;
      }

      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goldenCarrots', 'inventory', 'achievements', 'dailyStreak', 'claimedToday', 'level', 'username', 'photoURL', 'isAdmin'])
      );
    }

    match /scores/{scoreId} {
      allow read: if isSignedIn();
      
      function isValidScore(data) {
        return data.keys().hasAll(['userId', 'score', 'timestamp']) &&
               data.userId == request.auth.uid &&
               data.score is number;
      }

      allow create: if isSignedIn() && isValidId(scoreId) && isValidScore(request.resource.data);
      allow update, delete: if false;
    }

    match /stats/global {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    match /online_players/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
